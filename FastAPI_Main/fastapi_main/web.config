<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="uvicornmodule" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Users\aktiwari\Desktop\FastAPI\FastAPI_Venv\Scripts\uvicorn.exe" resourceType="Unspecified" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\Python312\python.exe" arguments="-m uvicorn --port %HTTP_PLATFORM_PORT% main:app" stdoutLogEnabled="true" stdoutLogFile=".\python.log" startupTimeLimit="20" />
  </system.webServer>
</configuration>
